    {
      "type": "timeseries",
      "title": "Tool calls by tool / outcome",
      "id": 15,
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
