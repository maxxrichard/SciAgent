      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(sciagent_http_requests_total{service=\"api\",status=~\"5..\"}[$__rate_interval])) / sum(rate(sciagent_http_requests_total{service=\"api\"}[$__rate_interval]))",
          "legendFormat": "5xx ratio",
          "refId": "A",
          "range": true,
          "instant": false
