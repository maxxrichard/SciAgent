# Copy to .env for local overrides. All settings use the SCIAGENT_ prefix.
SCIAGENT_ENV=local
SCIAGENT_LOG_LEVEL=INFO
SCIAGENT_DATABASE_URL=sqlite+pysqlite:///./sciagent.db
SCIAGENT_DATA_LAKE_URI=./.lake
SCIAGENT_LLM_BACKEND=rule          # rule | vllm
SCIAGENT_LLM_BASE_URL=http://localhost:8001/v1
SCIAGENT_LLM_MODEL=sciagent-llm
SCIAGENT_TOOL_TRANSPORT=local      # local | mcp
SCIAGENT_API_KEYS=dev-researcher-key:alice:researcher:imaging|genomics|clinical,dev-admin-key:admin:admin:*
